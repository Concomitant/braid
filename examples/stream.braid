# Codata. A Stream is defined by how it is OBSERVED, not how it is
# built — an infinite object, forced one cell at a time. The tail is a
# THUNK (Fn⟨• =Recursive> Stream(a)⟩), so the recursion is guarded and
# productive. Fn inside a `data` declaration is exactly what makes this
# expressible; the generated fold is (correctly) withheld — a structural
# fold through the thunk would never terminate.
#
# The thunk is written `=Recursive>` because a producer written under
# `with Recursive` fills it, and a written arrow means its manifest: an
# unlabelled `Fn⟨• ⇒ …⟩` would refuse `from` below. Productive, but
# unbounded — `Recursive` claims the second thing, not divergence.

data Stream(a) = (a Fn⟨• =Recursive> Stream(a)⟩)

def headS = Stream(h, t) -> h                    # observe the first cell
def tailS = Stream(h, t) -> t >> ev            # force one step

# the integers upward from n — the self-call sits UNDER a quote, so the
# stream is produced lazily, one cell per force.  A self-call inside a
# quotation is a CAPTURE, and abstraction elimination handles it like
# any other captured wire; guardedness (and so productivity) is the
# body's business, not the marker's.
def from with Recursive =
  (n -> n [n 1 >> + >> from] >> Stream)

# a constant stream — same shape, different generator
def repeat with Recursive =
  (x -> x [x >> repeat] >> Stream)

def nats = 0 >> from                             # 0, 1, 2, 3, …  (infinite)

# observe to finite depth; the stream never bottoms out
nats >> headS >> print                                          # 0
nats >> tailS >> tailS >> headS >> print                        # 2
(nats >> headS) (nats >> tailS >> headS) (nats >> tailS >> tailS >> headS) >> pack >> print   # list(0, 1, 2)

7 >> repeat >> tailS >> tailS >> tailS >> headS >> print         # 7 (forever)
