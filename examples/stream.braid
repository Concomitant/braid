# Codata. A Stream is defined by how it is OBSERVED, not how it is
# built — an infinite object, forced one cell at a time. The tail is a
# THUNK (Fn⟨• =Rec> Stream(a)⟩), so the recursion is guarded and
# productive. Fn inside a `data` declaration is exactly what makes this
# expressible; the generated fold is (correctly) withheld — a structural
# fold through the thunk would never terminate.
#
# The thunk is written `=Rec>` because a `fix`-built producer fills it,
# and a written arrow means its manifest: an unlabelled `Fn⟨• ⇒ …⟩`
# would refuse `from` below. Productive, but unbounded — `Rec` claims
# the second thing, not divergence.

data Stream(a) = (a Fn⟨• =Rec> Stream(a)⟩)

def headS = unStream >> (h t -> h)               # observe the first cell
def tailS = unStream >> (h t -> t) >> apply       # force one step

# the integers upward from n — the self-call still sits UNDER the
# quote, so the stream is produced lazily, one cell per force.  `fix`
# only moves the knot to a typed boundary; guardedness (and so
# productivity) is unchanged.
def from =
  [(self n -> n [n 1 >> + >> self ... >> apply] >> Stream)] ...
  fix ...
  apply

# a constant stream — same shape, different generator
def repeat =
  [(self x -> x [x >> self ... >> apply] >> Stream)] ...
  fix ...
  apply

def nats = 0 >> from                             # 0, 1, 2, 3, …  (infinite)

# observe to finite depth; the stream never bottoms out
nats >> headS >> print                                          # 0
nats >> tailS >> tailS >> headS >> print                        # 2
(nats >> headS) (nats >> tailS >> headS) (nats >> tailS >> tailS >> headS) >> pack >> print   # list(0, 1, 2)

7 >> repeat >> tailS >> tailS >> tailS >> headS >> print         # 7 (forever)
