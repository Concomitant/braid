# Every functor, seen from the user's side, is one function:
#
#     Fn⟨a ⇒ b⟩  ⇒  (something better)
#
# Take an ordinary function; get back the logged version, the
# game-advancing version, the version that runs one wire deeper
# (`lift`, in the prelude — tensorial strength). The lift IS the mark:
# you can see `>> logged` in the text, and the RESULT's arrow carries
# the receipt (`=Log>`). Nothing is inferred, nothing is hidden.

# ---- game rules advance game state -----------------------------------
# The moves are ordinary functions. No Game anywhere in sight.

resource Game = Int

def play  = (f -> [unGame >> f ... >> ev >> Game])
#   play : Fn⟨Int ⇒ Int⟩ ⇒ Fn⟨• =Game> •⟩ — a pure rule, made a move

def raise = 1 ... >> +
def dbl   = 2 _  >> *

# Lifted moves are VALUES, so a game is data: pack the rules, lift them
# all, fold them over the state. (A move sequence read from a file
# would run identically.)
([raise] [dbl] [raise] [dbl] >> pack) >> [play] ... >> map
[(x g -> g x >> ev)] (0 >> Game) ... >> fold
unGame >> print                                    # 6 — ((0+1)·2+1)·2

# ---- the logged version of a function --------------------------------
# The wrapper's body is written OBLIVIOUSLY: `with Log` inside the quote
# makes the elaborator thread the log wire, so `logged` is one line.

resource Log = Str
def note = unLog _ >> cat >> Log

def logged = (f -> [with Log = dup >> toStr >> note >> " " >> note >> f ... >> ev])
#   logged : Fn⟨a ⇒ ρ⟩ ⇒ Fn⟨a =Log> ρ⟩ — same function, now it remembers

def celsius = (n -> 9 n >> * >> _ 5 >> div >> 32 ... >> +)

([celsius] >> logged) ("" >> Log) 100 >> ev
_ print                                            # 212
unLog >> print                                     # 100 — the log

# The same shape one level up: a `Code ⇒ Code` functor applied by `with`
# is this action on a whole region's spine instead of one quotation —
# "the logged version of this block". See design-macros.md.

# ---- the same block, said by TRANSPORT --------------------------------
# The sentence at the top of this file is a theory slot:
#
#     embed : Fn⟨a ⇒ b⟩ ⇒ k(a, b)
#
# Take an ordinary function, get back the better one. That slot is the
# prelude doctrine's embedding, and a theory declared `in Doctrine`
# that takes it — with the doctrine's `compose` — presents a category,
# so `with` of one of its models takes over `;` as well: the lift applies
# to a whole block by its HEADER instead of one quotation at a time.
# `with Notes` below is the only mark, and the arrow carries the receipt.
#
# The carrier is written UNFOLDED (`Fn⟨Log a =Log> Log b⟩`): a resource
# folds onto the glyph for DISPLAY, and a written type says what the
# stack actually holds. The same is true of `=Notes>` itself.
# The hom-object's two arguments are STACKS, so `Logged(ρ, σ)` is the
# logged version of a program of ANY width — `Lifting` never declared a
# strength and now does not need one.  Inside, the two stacks ride in a
# `Box`, and THAT is where this file pays for the move: the wrapper
# logs its input with `toStr`, and `toStr` is a word about ONE WIRE.
# Braid has no renderer for a whole stack — `dup` copies a wire, `pack`
# wants a homogeneous bundle — so a logger over stacks logs the BOX,
# and a box renders as the one-alternative sum it is: `alt1(100)`
# rather than `100`.  Writing that down is more use than pretending
# otherwise; a `Show` for stacks is the thing that would fix it, and
# nothing in stage 7a ships one.
data Logged(a..., b...) = Fn⟨Log Box(a) =Log> Log Box(b)⟩

theory Lifting(k(..., ...)) in Doctrine =
    embed   : Fn⟨a ⇒ b⟩ ⇒ k(a, b)
    compose : k(a, b) k(b, c) ⇒ k(a, c)
    runP    : k(a, b) Log a =Log> Log b

# `embed` IS `logged`, one `Logged` wrapper later. The other two are the
# plumbing the transport does for you: written once, here, per model.
def logArr  = (f -> [unBox >> f ... >> ev >> Box] >> logged >> Logged)
def logThen = (f g -> [(l x -> f >> unLogged >> _ l >> _ _ x >> ev >> (m y -> g >> unLogged >> _ m >> _ _ y >> ev))] >> Logged)
def logRun  = _ _ Box >> (f l x -> f >> unLogged >> _ l >> _ _ x >> ev) >> _ unBox
#   logArr : Fn⟨ρ ⇒ σ⟩ ⇒ Logged(ρ, σ)

model Notes in Lifting(Logged) =
    embed   = logArr
    compose = logThen
    runP    = logRun

def triple = 3 _ >> *

# This is the payoff: the block reads like the ordinary program it is,
# and the arrow says what happened to it.
def piped with Notes = celsius >> triple
#   piped : Int =Notes> Int
#   — at the base `• ⇒ Logged(Int, Int)`, carrying the label `Notes`;
#   the display folds the carrier onto the arrow, exactly as it folds a
#   threaded resource.

# `runP` takes the carrier and returns base, so it is an EXIT: refused
# inside `with Notes`, and called under `in Notes`, which puts the
# model's words in scope and transports nothing.
#
# `Lifting` takes the doctrine's `compose` and `embed`, which since
# 2026-09-16 is the whole interface — so a stage of ANY width goes
# through, and this model never had to write a strength to get it.
# There are two levels now, not three: compose alone composes carriers
# by hand, and + embed transports.
def report in Notes = piped >> _ ("" >> Log) >> _ _ 100 >> runP

report >> _ print                                  # 636 — 212 tripled
unLog >> print                                     # alt1(100) alt1(212) — the log
