# Resources: effects as wires, and `use` to stop threading them by hand.
#
# The design bet (design-effects.md) is that the effect zoo decomposes
# into structure Braid already has — state is a threaded wire, a log is
# a wire, a reader is closure capture — and only IO is irreducible. A
# `resource` names such a wire. It is NOMINAL, so `Int Int` is never
# silently a GameState, and it rides DEEPEST, which is what puts every
# offset a known distance from the bottom.

resource Log     = Str
resource Counter = Int

# ---- the resource's operations: the only place roll/unroll appears ----
def note = unLog _ ; cat ; Log         # Str =Log> •
def bump = unCounter ; 1 ... ; + ; Counter

# ---- by hand: the wires are visible, and you count -------------------
# This is what the language gives you with no help: `_` steps over a
# resource, `...` threads the rest, and adding a third resource would
# renumber every line.
def scoreByHand =
    _ _ (dup ; *) ...
    _ bump ...
    _ _ "scored " ...
    swap ...                           # bring Log up beside the Str
    _ note ...
    swap ...                           # and put it back

# ---- with `use`: the same program, none of the arithmetic ------------
# `use` opens an ambient scope; the elaborator writes every `_` and
# `...` above from the resource signatures alone. It also ASSERTS the
# claim — the incoming wires must really be a Log and a Counter.
def score =
    use Log Counter
    dup ; *
    bump
    "scored "
    note

# score : Int ρ0 =Log Counter> Int ρ0
#   the resources fold onto the ARROW, which is what "threaded through"
#   means: the same prefix going in and coming out.

("" ; Log) (0 ; Counter) 7
score
score
unLog _ _ ; print ...                  # "scored scored "
unCounter _ ; print ...                # 2
print                                  # 2401 — 7 squared, twice

# ---- strength is an ordinary word ------------------------------------
# What `use` does to a PURE stage is exactly `lift`: run a program one
# wire deeper. It is the action of (A ⊗ −) on a morphism, and it needs
# no compiler support — compose it once per context wire.
(":" ; Log) 7
([dup ; *] ; lift) ...
apply
unLog _ ; print print                  # ":" untouched, 49

# ---- discharging a resource: a handler is a wrapping macro -----------
# An effectful arrow is a RESOURCE + a MACRO + a THEORY: the resource
# carries the state, the macro installs and discharges it, the theory
# says what the operations must satisfy. `use Log` is the entering half;
# this is the leaving half. It seeds a Log, applies the program, and
# unrolls the wire — so the arrow LOSES `=Log>` across it, with no
# language construct at all. (Plotkin–Pretnar: a handler is a model, and
# Braid's instances already are models, so discharge is a wrapping
# functor rather than a form.)

def collectLog = (f -> [f ("" ; Log) ... ; apply ; unLog ...])
# collectLog : Fn⟨ρ0 =Log> ρ1⟩ ⇒ Fn⟨ρ0 ⇒ Str ρ1⟩

def square =
    use Log
    dup ; *
    "squared "
    note

[square] ; collectLog ; _ 7 ; apply
print print                            # "squared " then 49

# ---- and once, for every resource ------------------------------------
# The handler above is per-resource BY NAME. A template is over a
# THEORY, never over a resource name — a resource scope is routing, and
# a body waiting for a resource would be waiting for an arity rather
# than for a name. Naming the two operations a handler actually needs
# makes it one theory plus a two-line instance per resource, and the
# handler is then written once:

theory Collector(e, a) =
    seed   : • ⇒ e
    unwrap : e ⇒ a

instance Logs : Collector(Log, Str) =
    seed   = "" ; Log
    unwrap = unLog

instance Counts : Collector(Counter, Int) =
    seed   = 0 ; Counter
    unwrap = unCounter

def collected = use Collector ; (f -> [f (seed) ... ; apply ; unwrap ...])

def collectCount = use Counts ; collected
# collectCount : Fn⟨ρ0 =Counter> ρ1⟩ ⇒ Fn⟨ρ0 ⇒ Int ρ1⟩

def tick =
    use Counter
    dup ; *
    bump

[tick] ; collectCount ; _ 7 ; apply
print print                            # 1 then 49
