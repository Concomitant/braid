def decr = _ 1 >> -
def sumStep = (a n -> n >> zero? >> ((z -> a >> done) | (m -> (a m >> +) (m >> decr) >> again)) >> merge)
def sumTo = [sumStep] ... >> loop

0 5 >> sumTo >> print

# same loop, body written inline as a router row
0 4
[(a n -> n >> zero? >> ((z -> a >> done) | (m -> (a m >> +) (m >> decr) >> again)) >> merge)] ...
loop
print
