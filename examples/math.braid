# Factorial, Fibonacci, exponentiation — recursive and iterative.
# Newlines are strict >>, so each step gets its own line. Every one is
# the same shape: a router picks base-vs-step, then one router row
# (base | step) >> merge, and postfix binders name the wires.

# --- recursive (fix: the knot is tied at a typed boundary, and the
# body names the recursive call `self` — a definition is not in scope
# in its own body) -----------------------------------------------------
def fac =
    [ self n ->
      n
      zero?
      ( (z -> 1) | (m -> m (m 1 >> - >> self ... >> ev) >> *) )
      merge ] ...
    fix ...
    ev

def fib =
    [ self n ->
      n 2
      lt?
      ( (x y -> x) | (x y -> (x 1 >> - >> self ... >> ev) >> _ (x 2 >> - >> self ... >> ev) >> +) )
      merge ] ...
    fix ...
    ev

def pow =
    [ self b e ->
      e
      zero?
      ( (z -> 1) | (m -> b (b (m 1 >> -) >> self ... >> ev) >> *) )
      merge ] ...
    fix ...
    ev

# --- iterative (loop: state is a stack, again re-enters / done exits) --
def facL =
    n ->
    1 n
    [ acc k ->
        k
        zero?
        ( (z -> acc >> done) | (m -> (acc m >> *) (m 1 >> -) >> again) )
        merge ] ...
    loop

def fibL =
    n ->
    0 1 n
    [ a b k ->
        k
        zero?
        ( (z -> a >> done) | (m -> b (a b >> +) (m 1 >> -) >> again) )
        merge ] ...
    loop

5 >> fac >> print       # 120
10 >> fib >> print      # 55
2 8 >> pow >> print     # 256
6 >> facL >> print      # 720
20 >> fibL >> print     # 6765
