# case(…): the coproduct eliminator. A right-nested sum (A | (B | C)) is
# a decision tree written in the type; case(hA, hB, hC) folds the whole
# spine in one shot — one handler per track, each a bare program, all
# landing on a common result. It is to sums what foldList is to lists.
#
# Deferred routers build the nest: each one answers its track and passes
# the rest down, so the leftover sum grows to the right.

def classify =
    negative?                          # (Int | Int)
    (drop >> "neg" | pass)             # (Str | Int)          answer track 1, defer track 2
    (pass | zero?)                     # (Str | (Int | Int))  route the leftover — the sum NESTS
    case(pass, drop >> "zero", toStr)  # (Str | (Str | Str)) -> Str, in one shot

-4 >> classify >> print   # neg
0  >> classify >> print   # zero
7  >> classify >> print   # 7

# assocL / assocR re-nest the tree: (A | (B | C)) <=> ((A | B) | C).
# Pure in1/in2 rewiring — rebalance a decision tree before folding it.
# Round-trip is identity on the routed value.
def tag = negative? >> (drop >> "neg" | pass) >> (pass | zero?)

5 >> tag >> assocL >> assocR >> case(pass, drop >> "zero", toStr) >> print   # 5
