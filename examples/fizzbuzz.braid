# The citizenship test. A guard is a ladder of [router] [action] lanes
# — each line pushes UNDER (`...`), and the top-first pack2R makes list
# order = text order — a first-class value (a product, so `choose`
# probes each), fed to `choose`, which runs the first lane whose router
# hits and returns (result | unmatched-input). The final
# (id | else) >> merge supplies the default.

def by15? = (n -> n 15 >> mod >> zero >> (n | n))
def by3?  = (n -> n 3 >> mod >> zero >> (n | n))
def by5?  = (n -> n 5 >> mod >> zero >> (n | n))

# the guard list is an ordinary value — bound here, used below:
def fbCases =
    [by15?] [drop >> "FizzBuzz"]
    [by3?]  [drop >> "Fizz"] ...
    [by5?]  [drop >> "Buzz"] ...
    pack2R

def fizzbuzz = (n -> n fbCases >> choose >> (id | toStr) >> merge)

15 >> range >> [1 ... >> + >> fizzbuzz] ... >> map >> printAll
