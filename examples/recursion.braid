# Recursion is written with `fix`, at a typed boundary. A definition is
# NOT in scope in its own body, so the knot is tied by a word with a
# type — `fix : Fn⟨Fn⟨ρ0 =Rec> ρ1⟩ ρ0 ⇒ ρ1⟩ ⇒ Fn⟨ρ0 =Rec> ρ1⟩` — and the
# body receives the recursive call DEEPEST, as an ordinary quoted
# function. The three stages read: quote the body, tie the knot, ev
# it. `Rec` is the receipt: `fix` and `loop` are the only words that can
# run unbounded, so everything built from them says so on its arrow, and
# a word with no `Rec` is fix-free and terminates by construction.

def decr = _ 1 >> -
def lt2? = _ 2 >> lt? >> (_ drop | _ drop)
def lt100? = _ 100 >> lt? >> (_ drop | _ drop)
def double = 2 _ >> *

# point-free: an OPEN binder (`self ... ->`) names only the knot and
# lets the wire flow through, so the body reads exactly as before
def until100 =
  [ self ... ->
    lt100?
    double >> self ... >> ev | _
    merge ] ...
  fix ...
  ev

def sumTo =
  [(self a n -> n >> zero? >> ((z -> a) | (m -> (a m >> +) (m >> decr) >> self ... >> ev)) >> merge)] ...
  fix ...
  ev

def fib =
  [ self ... ->
    lt2?
    _ | (n -> n >> decr >> self ... >> ev >> _ (n 2 >> - >> self ... >> ev) >> +)
    merge ] ...
  fix ...
  ev

7 >> until100 >> print
0 5 >> sumTo >> print
10 >> fib >> print
