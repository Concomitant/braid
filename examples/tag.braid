# Naming a wire without cutting it.
#
# The arrow's SIDE says what happens to the wires it names.
#
#   x y ->     names BEFORE the arrow are CUT: the body starts from an
#              empty stack and puts everything back by name.
#   -> x y     names AFTER the arrow are LABELS: identity at runtime, so
#              the wires flow straight on and the names are there too.
#
# In a drawn diagram you write a label beside a wire without breaking
# it; the second form is that. It is sugar, not machinery:
#
#   -> x _ y   ≡   x _ y ... -> x _ y ...
#
# Slots use the ordinary stage vocabulary — a name takes one wire, `_`
# skips one — exactly as atoms do in `print print _`.

# ---- the two binders, same answer ---------------------------------------
def consumed =
    h m f ->                       # wires gone; the body re-pushes them
    h m f ; sumN

def tagged =
    -> h m f                       # wires still flowing, names as well
    sumN

10 20 30 ; consumed ; print        # 60
10 20 30 ; tagged   ; print        # 60

# ---- what the label buys ------------------------------------------------
# Keep the pipeline moving AND keep a handle on what went past: the
# running total comes from the live wires, the report from the names.
# Nothing had to be re-pushed to stay in the flow.
def audited =
    -> h m f
    sumN ; print                   # the wires themselves, summed
    h ; print                      # and the label, still in scope

10 20 30 ; audited                 # 60, then 10

# ---- a label outlives its wire ------------------------------------------
# The wire is still on the stack, so mentioning the name is a `dup` in
# diagram terms — and the name survives the wire being consumed.
7 -> x -> drop                     # the wire goes...
x x ; * ; print                    # ...the name remains: 49

# ---- `_` reaches past a wire you don't want to name ---------------------
# Slots are positional from the deepest wire, so `_` is how you name the
# third thing without naming the first two.
1 "a" .foo -> _ _ tag -> print print drop
tag ; print                        # .foo — named without naming 1 or "a"

# ---- it is wiring, and you can see it -----------------------------------
# reflect compiles the names away into dup/swap/drop — no environment,
# no special form. The label above is a `dup` placed early.
[-> x -> drop ; x ...] ; reflect ; (unparse ; print | print) ; forget

# ---- brackets may span lines --------------------------------------------
# A newline against a bracket's inner edge is layout, not a stage
# boundary, so a wide atom can wrap. (Between stages it is still `>>`.)
def dot = zipN ; [(acc a b ->
                     (a b ; *) acc ; +)] 0 ... ; foldExp2

2 3 5 95 90 95 ; dot ; print       # 935
