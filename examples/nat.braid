# Peano arithmetic as user code. Nat is the initial algebra of the row
# functor (• | X): Nat rolls, unNat unrolls, both runtime no-ops.

type Nat = (• | Nat)

def z = alt1 >> Nat
def s = alt2 >> Nat

def fromInt =
  [(self ... -> zero? >> (drop >> z | _ 1 >> - >> self ... >> ev >> s) >> merge)] ...
  fix ...
  ev
## toInt by points: zero maps to 0, successor to +1 on the result
def toInt = [0] [1 ... >> +] ... >> foldNat

## addition by structural recursion on the second argument: that is
## what foldNat IS, so add needs no knot — zero maps to m, successor
## to s on the result
def add = (m n -> n >> [m] [s] ... >> foldNat)

3 >> fromInt >> toInt >> print                             # 3
2 >> fromInt >> _ (3 >> fromInt) >> add >> toInt >> print  # 5
