# A category whose carrier is the program AND its Code.
#
# `examples/circuits.braid` says the shape rule once: a model whose
# theory has a hom-object `k(_, _)` and declares slots at the
# composition, embedding and strength SHAPES presents a category, and
# `use` of it transports base programs into that category.  This file
# is a second model of that rule with nothing in common with circuits
# except the shape — its carrier is a PAIR of the program and the Code
# the elaborator handed it, so a transported word can be RUN and READ.
#
# The point to take away, and the reason the file is short: `getCode`
# and `evalAs` are THIS MODEL's embedding and exit.  `Code` is not a
# special floor that metaprogramming happens on; it is one more carrier
# a theory can name, reached and left through slots like any other.

data Coded(a, b) = Fn⟨a ⇒ b⟩ Code
data Pair(a, b)  = a b

# ---- the theory ------------------------------------------------------
# Four slots, and the elaborator reads three of them by SHAPE:
# `compose` is `k(a,b) k(b,c) ⇒ k(a,c)`, `embed` is `Fn⟨a ⇒ b⟩ ⇒
# k(a,b)`, `first` is `k(a,b) ⇒ k(P(a,c), P(b,c))`.  `run` has a
# carrier in and none out, so it is an EXIT: legal under `over`, never
# inside `use`.  The names are this file's taste; nothing reads them.
theory Reflective(k(_, _)) =
    embed   : Fn⟨a ⇒ b⟩ ⇒ k(a, b)
    compose : k(a, b) k(b, c) ⇒ k(a, c)
    first   : k(a, b) ⇒ k(Pair(a, c), Pair(b, c))
    run     : k(a, b) a ⇒ (b | Str a)

# ---- what the prelude lacks ------------------------------------------
# Composition of two WITNESSES, at one wire.  The prelude has `lift`
# and `around` but no `Fn ; Fn` — it is three atoms with a binder, and
# `ev` is what makes it possible at all (the closure gate, 5a¾).
def composeFn = (f g -> [(x -> f ; _ x ; ev ; (y -> g ; _ y ; ev))])
def orNil     = ((c -> c) | drop ; nil) ; merge

# ---- the model -------------------------------------------------------
# The embedding is the whole idea: take the program, ask it for its
# Code, and keep both.  `getCode` works here because what `use` hands
# the embedding is a literal quotation of the stage — not a closure.
def embedC = (f -> f (f ; getCode) ; Coded)

# Composition composes the witnesses and APPENDS the spines, which is
# the statement that Code is a free monoid on stages and `;` is its
# multiplication.
def composeC = (c d -> c ; unCoded ; (f p -> d ; unCoded ; (g q -> (f g ; composeFn) (p q ; append) ; Coded)))

# The strength lifts the witness the ordinary way, and ROUTES the
# spine: a program on the deepest wire of a pair is the spine quoted,
# slid under, and applied to that wire alone — `[p] ... >> onFirst` —
# between `unPair` and `Pair`.  Written as source and parsed, because
# that is what a Code-building API would give us and stage 6 does not
# have one yet (pragmatics item E).
def onFirst    = (q x d -> q ; _ x ; ev ; (y -> y d))
def firstSpine = (s -> "unPair >> [" (s ; unparse) ; cat ; _ "] ... >> onFirst >> Pair" ; cat ; parse ; orNil)

def firstC = (c -> c ; unCoded ; (f s -> [(q -> q ; unPair ; (x d -> f ; _ x ; ev ; (y -> y d ; Pair)))] (s ; firstSpine) ; Coded))

# The exit runs the SPINE against the witness, which is `evalAs`: the
# witness is the ascription and the re-inference at the splice is the
# check.  A model's exit, not a language escape hatch.
def runC = (c x -> c ; unCoded ; _ _ x ; evalAs)

model Reified : Reflective(Coded) =
    embed   = embedC
    compose = composeC
    first   = firstC
    run     = runC

# ---- transport -------------------------------------------------------
# `dup` leaves two wires and `*` takes two, so neither is one-wire:
# they transport through the strength, packed with the pairing `Pair`
# that `first`'s declared type names.
def sq = use Reified ; dup ; *
#   sq : Int =Reified> Int

# The carrier is readable, because that is what this carrier IS.
sq ; unCoded ; drop _ ; unparse ; print

# ...and runnable, through the exit.
def sq5 = over Reified ; sq ; _ 5 ; run
sq5 ; (... | drop _ ; drop ; 0) ; merge ; print    # 25

# And the STRENGTH is real, not decoration.  `add1 ...` acts on the
# deepest wire and the one above it rides along, so the elaborator
# whiskers it with `first` — and this model's `first` routes the spine
# as well as the witness, so the Code stays runnable.
def add1 = _ 1 ; +
def w    = use Reified ; dup ; add1 ... ; *
w ; unCoded ; drop _ ; unparse ; print
def w5 = over Reified ; w ; _ 5 ; run
w5 ; (... | drop _ ; drop ; 0) ; merge ; print    # 30 — (5+1)·5
