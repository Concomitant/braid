# The closed structure, stated as a theory: `dist2`/`undist2` and the
# coproduct's own two laws, written as runnable laws over two models.
#
# Braid is cartesian CLOSED (`curry`/`ev`) and has coproducts, so it is
# DISTRIBUTIVE for free: `P × –` is a left adjoint, left adjoints
# preserve colimits, and `dist2`'s prelude body is that proof written
# out — capture `P` into one handler per track, then `case2`. Nothing
# below is an axiom; `:doc dist2` has the derivation.
#
# Stage 5a¾ made this load-bearing: abstraction elimination reifies a
# binder parameter used inside a ROW by distributing the parameter block
# over the row's tracks with exactly this word (MANUAL §6).
#
# STATUS, 2026-09-13: DECIDED. Every law below was a check at sample
# points until the normalizer learned to enter quotations and rows
# (§12.9). It is now a proof: `sameCode` normalizes both sides to a case
# tree over the free distributive category — following a known injection
# is β, and splitting an unknown one is extensivity — so `true` here
# means the law holds at EVERY input and under every reading of the
# slots, not that it held at the three numbers we tried.

# The router each model supplies for `pick`: a sum wire whose injection
# nobody knows, which is what makes the laws below theorems about an
# arbitrary sum rather than about `alt1`.  Polymorphic, so both models
# use the same one.
def router = dup >> eq? >> (_ drop | _ drop)

theory Distributive(a) =
    # a map on the distributed wire, and one per track of the sum
    p      : a ⇒ a
    f      : a ⇒ a
    g      : a ⇒ a
    # an ARBITRARY sum: the normalizer must split on it, not follow it
    pick   : a ⇒ (a | a)
    # --- the coproduct's own two laws ---------------------------------
    # β: injecting then casing picks the branch you injected into.
    law beta = [alt1 >> (f | g) >> merge] [f] >> sameCode
    # η: casing into the injections is the identity.
    law eta = [pick >> (alt1 | alt2) >> merge] [pick] >> sameCode
    # --- dist and undist are inverse ----------------------------------
    law distUndist = [_ pick >> dist2 >> undist2 >> _ merge] [_ pick >> _ merge] >> sameCode
    law undistDist = [pick >> undist2 >> dist2 >> merge] [pick >> merge] >> sameCode
    # --- naturality ---------------------------------------------------
    # in the SUM: mapping the tracks commutes with distributing.
    law natSum = [_ pick >> _ (f | g) >> dist2 >> merge] [_ pick >> dist2 >> (_ f | _ g) >> merge] >> sameCode
    # in P: mapping the distributed wire commutes with distributing.
    law natP = [_ pick >> p _ >> dist2 >> merge] [_ pick >> dist2 >> (p _ | p _) >> merge] >> sameCode
    # --- coherence with the codiagonal --------------------------------
    # distributing and then merging is merging with P passing beneath.
    law distMerge = [_ pick >> dist2 >> merge] [_ pick >> _ merge] >> sameCode
model IntD : Distributive(Int) =
    p      = _ 1 >> +
    f      = _ 10 >> *
    g      = _ 100 >> *
    pick   = router
model StrD : Distributive(Str) =
    p      = _ "!" >> cat
    f      = _ "-f" >> cat
    g      = _ "-g" >> cat
    pick   = router
"-- seven laws, two models, all DECIDED before main --" >> print

# The same verdicts, printed rather than audited, so you can see them.
def v = ("same" | "differ") >> merge
def f10 = _ 10 >> *
def g100 = _ 100 >> *
"beta      " >> print
[alt1 >> (f10 | g100) >> merge] [f10] >> sameCode >> v >> print
"eta       " >> print
[router >> (alt1 | alt2) >> merge] [router] >> sameCode >> v >> print
"distMerge " >> print
[_ router >> dist2 >> merge] [_ router >> _ merge] >> sameCode >> v >> print
# and the track swap, which is NOT the identity — the procedure answers,
# it does not merely fail to object
"track swap" >> print
[router >> (alt2 | alt1) >> merge] [router] >> sameCode >> v >> print

# The words themselves, at sample points.
7 (5 >> alt1) >> dist2 >> (+ | -) >> merge >> print          # 12
7 (5 >> alt2) >> dist2 >> (+ | -) >> merge >> print          # 2
7 5 >> alt1 >> undist2 >> dist2 >> (+ | -) >> merge >> print  # 12
7 5 >> alt2 >> undist2 >> dist2 >> (+ | -) >> merge >> print  # 2

# The nested family, following `caseN`: `dist3` distributes over
# `(ρ0 | (ρ1 | ρ2))`, the shape `case3` eliminates.
7 (5 >> alt1) >> dist3 >> (+ | (- | *) >> merge) >> merge >> print   # 12
7 (5 >> alt2 >> alt2) >> dist3 >> (+ | (- | *) >> merge) >> merge >> print  # 35

# And the reason the stage needed them: a binder parameter used inside a
# row now reifies, by distributing the parameter block over the row.
[(n -> n >> zero >> (n >> drop >> 1 | n n >> *) >> merge)] >> reflect >> ((c -> c >> unparse >> print) | print) >> merge
