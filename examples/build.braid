# Two builds, one pipeline: configurations as models, the pipeline as
# a TEMPLATE.
#
# A def whose header is `over THEORY` is a template: it is a morphism of
# the theory, and its body waits for a model.  A def whose `use`
# names a MODEL supplies one — the
# template's body is expanded there, renamed by that model, and
# re-inferred there.  So every instantiation gets its own principal type
# and nothing is dispatched at run time.  ML's functor application,
# spelled as scope.

theory Config(v) =
    name    : • ⇒ Str
    target  : • ⇒ Str
    retries : • ⇒ Int
    version : • ⇒ v
    flags   : Str ⇒ Str

model Dev : Config(Int) =
    name    = "dev"
    target  = "build/dev/app"
    retries = 1
    version = 0
    flags   = _ " -g -O0" ; cat

model Prod : Config(Str) =
    name    = "prod"
    target  = "build/prod/app"
    retries = 3
    version = "2026.09"
    flags   = _ " -O2 --strip" ; cat

# ---- written once, over the theory ----------------------------------
# No `@`, no dictionary, no parameter: `over Config` says this def is a
# morphism of the theory, and that is the whole of "generic over a
# Config".  `over` DECLARES and applies nothing; `use` APPLIES.

def banner =
    over Config
    "== " name ; cat
    _ " ==" ; cat

## the version and the name it belongs to — one body, two TYPES
def stamped =
    over Config
    version
    _ name

# a template may call a template: `plan` meets `banner` and `stamped`
# still waiting, and the model that instantiates `plan` instantiates
# them too.
def plan =
    over Config
    banner ; print
    target ; flags ; print
    stamped ; print print
    retries ; print

# ---- instantiated twice, by scope ------------------------------------
def devBuild  = use Dev  ; plan
def prodBuild = use Prod ; plan

## the same body at two types: `• =Dev> Int Str` here …
def devStamp  = use Dev  ; stamped
## … and `• =Prod> Str Str` here.  Re-inferred per model, so no
## rank-1 wall — and the receipt says which model read the template.
def prodStamp = use Prod ; stamped

devBuild
prodBuild

# `plan` outside any Config scope is an elaboration error, and it names
# the theory rather than the missing word:
#   plan needs a model of Config in scope (`use <model>` before
#   calling it)
