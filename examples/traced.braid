# A tracer that lifts at every cut.
#
# The tempting tracer reads the wire — `dup ... ; print ...` — and that
# stage is `a ρ =IO> a ρ`: it needs a wire, so it fails at an empty cut
# and, on a binder body, prints the parameter block (the deepest wire
# for the body's duration).  The stage that can go anywhere touches NO
# wire: `"after dup" pass ; print pass` is `ρ =IO> ρ`.  Its content
# comes from the functor, which has the stage in hand.  That is what
# `interpose` checks: the inserted stage must be a unit endomorphism,
# `ρ ⇒ ρ`, whiskered by whatever the cut carries.

def orNil = ((c -> c) | drop ; nil) ; merge

# the marker for one stage, built as text and parsed back to Code
def markStage = (s -> "\"after " (s ; pack ; unparse) ; cat ; _ "\" ... ; print ..." ; cat ; parse ; orNil)

# A `functor` takes a GRAPH MORPHISM — one image per generator,
# `Fn⟨Stage ⇒ Code⟩` — and a functor out of a free category IS a graph
# morphism, so the extension to every spine is what the declaration
# MEANS rather than something written here.  This one sends the stage s
# to s followed by markStage(s).
functor Traced = [(s -> (s ; pack) (s ; markStage) ; append)]

def poly with Traced =
    dup ; *
    dup ; +
    _ 1 ; +

"-- every stage announces itself --" ; print
5 ; poly ; print                       # after dup … after +, then 51

# A binder body is wiring too, so it traces stage by stage — all of it,
# including the routing of its parameter block.
def clamp with Traced =
    (lo hi x -> lo x ; lt? ; (drop _ | _ drop) ; merge ; _ hi ; lt? ; (_ drop | drop _) ; merge)

"-- a binder, elaborated and traced --" ; print
0 10 37 ; clamp ; print                # fifteen markers, then 10

# The same insertion with a FIXED marker is `interpose`, which BUILDS
# the graph morphism — `interpose : Code ⇒ Fn⟨Stage ⇒ Code⟩` — and the
# check is what makes it a functor you can trust: a stage that reads a
# wire is refused by name, at elaboration, before it is inserted
# anywhere.
def tick = ["tick" ... ; print ...] ; getCode
def ticked = tick ... ; interpose
functor Ticked = ticked

def twice with Ticked =
    dup ; +

"-- interpose: one marker after every stage --" ; print
21 ; twice ; print                     # tick, tick, 42

# THE RECEIPT.  `with Traced` leaves `Traced` on the manifest of
# everything it elaborated: `poly : Int =Traced> Int`, and every caller
# of `poly` inherits it by row unification.  The label is minted by the
# scope and by nothing else — `with@Traced` written by hand is refused —
# so a manifest is evidence about how a word was built, not a claim its
# author made.  Two ways to see it from inside a program:
def quoted = [with Ticked = dup ; +]

"-- the receipt is a stage, so it reflects with the code --" ; print
quoted ; getCode ; unparse ; print      # with@Ticked >> dup >> "tick" pass …

# and it is part of the type, so a witness must carry it too: an
# unlabelled `Fn` refuses instrumented code exactly as a pure one
# refuses io.
"-- a witness that carries the label runs the code --" ; print
[with Ticked = dup ; +] (quoted ; getCode) (20) ; evalAs ; (print | print forget) ; merge
"-- an unlabelled witness refuses it --" ; print
[dup ; +] (quoted ; getCode) (20) ; evalAs ; (print | print forget) ; merge

# Uncomment to see the refusal:
#   def peek = [dup ... ; print ...] ; getCode
#   def peeked = peek ... ; interpose
#   functor Peeked = peeked
#   def bad = use Peeked ; dup ; +
# interpose: `dup pass >> print pass` is a0 ρ0 =IO> a0 ρ0, which reads a
# wire; a stage inserted at every cut must be ρ ⇒ ρ, or E ρ ⇒ E ρ for
# resource wires E routed beneath the whole scope
