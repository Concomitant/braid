# Guard ladders as ordinary words — no parser support, no sugar.
#
# The headline form: one lane per line, `...` accumulates, `decide`
# folds. A lane is a bare Bool condition beside its answer; the final
# lane is the default (no condition). The trailing `...` is the
# ordinary explicit-remainder marker — each lane line pushes UNDER the
# growing product, so lanes stack reversed and decide's overwrite fold
# (deepest first) makes the FIRST-written true lane win. All conditions
# are probed (a product — pure, so harmless); answers are plain values.
def sign =
    x ->
    (x >> negative) "neg"  ...
    (x >> zero)     "zero" ...
    (x >> toStr)           ...
    decide

-4 >> sign >> print     # neg
0  >> sign >> print     # zero
7  >> sign >> print     # 7

# Word-chain form: fold as you go instead. `if` opens a (decided | •)
# wire, `elif` probes only while undecided, `else` closes. One `_` per
# continuation line passes the running wire along (the frame tax,
# constant). Equivalent railway spelling: chain `>> if` lines with
# >?> and close with >!> — no `_` (the miss track is empty, so lane
# pushes are free there).
def sign2 =
    x ->
    (x >> negative) "neg"  >> if
    _ (x >> zero)   "zero" >> elif
    _ (x >> toStr)         >> else

-4 >> sign2 >> print    # neg
0  >> sign2 >> print    # zero
7  >> sign2 >> print    # 7

# Deeper ladder in the headline style; conditions are arbitrary Bool
# expressions. (For lazy answers, quote them and `decide >> apply` —
# or use the word chain with `otherwise` and a quoted default.)
def grade =
    x ->
    (89 x >> less) "A" ...
    (79 x >> less) "B" ...
    (69 x >> less) "C" ...
    "F"                ...
    decide

95 >> grade >> print    # A
85 >> grade >> print    # B
75 >> grade >> print    # C
50 >> grade >> print    # F

# Routing variant: ifRoute / elifRoute take a quoted ROUTER and feed its
# hit value into the action (the action sees the routed value, not a
# fresh subject); `otherwise` closes on the still-routed miss track.
def classify =
    _ [odd?]      [dup >> *]    >> ifRoute      # square the odd value
    _ [negative?] [drop >> 0]   >> elifRoute    # clamp negatives to 0
    _ [pass]                    >> otherwise    # keep it (all arms are Int)

7  >> classify >> print   # 49
-4 >> classify >> print   # 0
6  >> classify >> print   # 6

# The product form: lanes laid FLAT as (condition, action) pairs —
# default FIRST, then (Bool Fn)ⁿ — and firstTrue folds the bundle. All
# conditions are probed; the first true lane's action runs; exactly one
# action ever runs. Guard count is just stack width (the exponent).
def sign3 =
    x ->
    [x >> toStr] (x >> negative) ["neg"] (x >> zero) ["zero"]
    firstTrue

-4 >> sign3 >> print    # neg
0  >> sign3 >> print    # zero
7  >> sign3 >> print    # 7
