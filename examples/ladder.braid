# Guard ladders as ordinary words — no parser support, no sugar.
# `if` / `elif` / `else` are three tiny prelude defs. Bind the subject,
# and a guard is a bare Bool condition beside its answer — no quotes,
# no routers, one guard per line. The running wire is (decided | •):
# the first true lane decides, and a decision rides through the rest.
# The `_` passes it along each continuation line (the usual frame tax,
# constant — one per line).
def sign =
    x ->
    (x >> negative) "neg"  >> if
    _ (x >> zero)   "zero" >> elif
    _ (x >> toStr)         >> else

-4 >> sign >> print     # neg
0  >> sign >> print     # zero
7  >> sign >> print     # 7

# Answers are ANY values; quote only when the answer does work, and
# close with `otherwise` (quoted default = lazy: runs only if nothing
# hit).  Conditions are arbitrary Bool expressions.
def grade =
    x ->
    (89 x >> less) "A"   >> if
    _ (79 x >> less) "B" >> elif
    _ (69 x >> less) "C" >> elif
    _ ["F"]              >> otherwise

95 >> grade >> print    # A
75 >> grade >> print    # C
50 >> grade >> print    # F

# Routing variant: ifRoute / elifRoute take a quoted ROUTER and feed its
# hit value into the action (the action sees the routed value, not a
# fresh subject); `otherwise` closes on the still-routed miss track.
def classify =
    _ [odd?]      [dup >> *]    >> ifRoute      # square the odd value
    _ [negative?] [drop >> 0]   >> elifRoute    # clamp negatives to 0
    _ [pass]                    >> otherwise    # keep it (all arms are Int)

7  >> classify >> print   # 49
-4 >> classify >> print   # 0
6  >> classify >> print   # 6

# The product form: lanes laid FLAT as (condition, action) pairs —
# (Bool Fn)ⁿ, default on top — and firstTrue folds the bundle. All
# conditions are probed; the first true lane's action runs; exactly one
# action ever runs. Guard count is just stack width (the exponent).
def sign3 =
    x ->
    (x >> negative) ["neg"] (x >> zero) ["zero"] [x >> toStr]
    firstTrue

-4 >> sign3 >> print    # neg
0  >> sign3 >> print    # zero
7  >> sign3 >> print    # 7
