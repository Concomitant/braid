import "util.braid"

def quadruple = double >> double

def scored with Tally Loud Same =
    emit
    double

## the imported template, instantiated on this side of the boundary
def loudTwice with Loud = emitTwice

## the imported rule set, applied on this side of the boundary
def optimised with Opt =
    dupInt
    +

7 >> quadruple >> print
6 >> optimised >> print
3 >> loudTwice >> print
(0 >> Tally) 5 >> scored >> _ print >> unTally >> print

## the imported MODE, entered on this side of the boundary: the receipt
## is minted here, and `runP` is the exit, called outside the scope
def inK  with Funcs = double >> double
def outK in Funcs = inK >> _ 5 >> runP
outK >> print
