## a library file: its declarations travel, its main does not
type Celsius = Int

resource Tally = Int
def bump = unTally >> _ 1 >> + >> Tally

def double = dup >> +

theory Sink(a) =
    emit : a ⇒ a

model Loud in Sink(Int) =
    emit = dup >> *

def idF = (c -> c)
functor Same = idF

## an INSTANCE OF `Base` travels like any other declaration: the
## renaming and the word of the same name both cross the boundary
def dupInt = dup >> _ _ 0 >> _ +
model Opt in Base = dupInt = dup

## a TEMPLATE over Sink: no instance here, so it is not a def yet —
## it travels as a template and the importer instantiates it
def emitTwice in Sink = emit ; emit

## a TRANSPORTING MODEL travels like any other declaration: the model,
## its shape, the word of its own name and the K-word table all cross
data Arr(a, b) = Fn⟨a ⇒ b⟩

theory Arrow(k(_, _)) in Doctrine =
    embed   : Fn⟨a ⇒ b⟩ ⇒ k(a, b)
    compose : k(a, b) k(b, c) ⇒ k(a, c)
    runP    : k(a, b) a ⇒ b

def thenA = (f g -> [(x -> f ; unArr ; _ x ; ev ; (y -> g ; unArr ; _ y ; ev))] ; Arr)
def runA  = (f x -> f ; unArr ; _ x ; ev)

model Funcs in Arrow(Arr) =
    embed   = Arr
    compose = thenA
    runP    = runA

"util.braid's own main — NOT run when imported" >> print
