## a library file: its declarations travel, its main does not
type Celsius = Int

resource Tally = Int
def bump = unTally >> _ 1 >> + >> Tally

def double = dup >> +

theory Sink(a) =
    emit : a ⇒ a

instance Loud : Sink(Int) =
    emit = dup >> *

def idF = (c -> c)
functor Same = idF

## an INSTANCE OF `Base` travels like any other declaration: the
## renaming and the word of the same name both cross the boundary
def dupInt = dup >> _ _ 0 >> _ +
instance Opt : Base = dupInt = dup

## a TEMPLATE over Sink: no instance here, so it is not a def yet —
## it travels as a template and the importer instantiates it
def emitTwice = over Sink ; emit ; emit

## a MODE travels like any other declaration: the instance it names,
## the word of the mode's own name and the functor entry all cross
data Arr(a, b) = Fn⟨a ⇒ b⟩

theory Arrow(k(_, _)) =
    arrP  : Fn⟨a ⇒ b⟩ ⇒ k(a, b)
    thenP : k(a, b) k(b, c) ⇒ k(a, c)
    runP  : k(a, b) a ⇒ b

def thenA = (f g -> [(x -> f ; unArr ; _ x ; ev ; (y -> g ; unArr ; _ y ; ev))] ; Arr)
def runA  = (f x -> f ; unArr ; _ x ; ev)

instance Funcs : Arrow(Arr) =
    arrP  = Arr
    thenP = thenA
    runP  = runA

mode K = Funcs

"util.braid's own main — NOT run when imported" >> print
